PORT=3000
# Sin clave, el servicio usa un clasificador local de respaldo (útil para pruebas).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tiempo máximo y reintentos ante caídas de la API de OpenAI
OPENAI_TIMEOUT_MS=10000
OPENAI_MAX_RETRIES=2
# Webhook opcional (Make/Zapier) que se dispara al crear un ticket
TICKET_WEBHOOK_URL=
DATA_FILE=data/db.json
# Clave que protege el panel docente (tickets y métricas). Definila antes de publicar.
TEACHER_API_KEY=
# Límite de consultas al chat por IP y ventana (protege el gasto de OpenAI)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
